NEXT_PUBLIC_APP_NAME=Lumen Forge
# Optional for local/API-key authentication; Vercel deployments can use OIDC.
AI_GATEWAY_API_KEY=
# Optional for OpenAI-compatible providers.
OPENAI_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Provider names are selected by worker/providers/index.ts
VIDEO_PROVIDER=replicate
# Set VIDEO_PROVIDER=protoface to use the Protoface async video provider.
PROTOFACE_API_KEY=
PROTOFACE_API_URL=https://api.protoface.com/v1/runs
PROTOFACE_VIDEO_MODEL=minimax/minimax-h3
PROTOFACE_IMAGE_MODEL=openai/gpt-image-2
# Replicate model must expose prompt and duration/duration_seconds inputs.
REPLICATE_VIDEO_MODEL=minimax/video-01-live
# Dedicated worker service configuration
WORKER_API_URL=http://localhost:3000
WORKER_API_SECRET=
WORKER_QUEUE_KEY=generation:pending
WORKER_POLL_INTERVAL_MS=1000
# Replicate credentials: use REPLICATE_API_TOKEN for worker deployments, or provide it through your deployment secret manager.
REPLICATE_API_TOKEN=
# Vercel Connect can still be used by an outer application, but the worker reads the explicit token above.
# Supported values: replicate or http (http requires an endpoint URL)
IMAGE_PROVIDER=replicate
# Flux model in owner/model format. Uses the Replicate Connect credential.
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-dev
IMAGE_PROVIDER_URL=
# Supported values: elevenlabs or http (http requires an endpoint URL)
VOICE_PROVIDER=elevenlabs
# ElevenLabs TTS configuration. API_KEY may be used as a project fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AUDIO_PROVIDER_URL=
# Local timeline writes ordered media metadata; export writes a private MP4 to Blob storage.
TIMELINE_PROVIDER=local
VIDEO_EXPORT_PROVIDER=local
APP_URL=http://localhost:3000
WORKER_PORT=8787
WORKER_TOKEN=
DEMO_MODE=true
