NEXT_PUBLIC_APP_NAME=Lumen Forge
# Optional for local/API-key authentication; Vercel deployments can use OIDC.
AI_GATEWAY_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Provider names are selected by worker/providers/index.ts
VIDEO_PROVIDER=replicate
REPLICATE_VIDEO_MODEL=
# Replicate access is supplied by the Vercel Connect connector.
# Do not add a static token here; configure the Replicate connector instead.
# Supported values: replicate or http (http requires an endpoint URL)
IMAGE_PROVIDER=replicate
# Flux model in owner/model format. Uses the Replicate Connect credential.
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-dev
IMAGE_PROVIDER_URL=
# Supported values: elevenlabs or http (http requires an endpoint URL)
VOICE_PROVIDER=elevenlabs
# ElevenLabs TTS configuration. API_KEY may be used as a project fallback.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AUDIO_PROVIDER_URL=
# Local export writes a private JSON manifest to Blob storage
VIDEO_EXPORT_PROVIDER=local
APP_URL=http://localhost:3000
WORKER_PORT=8787
WORKER_TOKEN=
DEMO_MODE=true
